<Window x:Class="MabiCommerceNewLife.AutoExpandedRoutesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expanded Auto Routes"
        Width="1180" Height="775" MinWidth="1000" MinHeight="650"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding RewardTooltip}" />
        </Style>
        <Style x:Key="ExpandedGoldActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#271D10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="#5D4728" BorderBrush="#3F301C" BorderThickness="1" />
                            <Border x:Name="Face" Margin="1" Background="#C39A46" BorderBrush="#E0C273" BorderThickness="1,1,0,0" />
                            <Border x:Name="Shade" Margin="2" BorderBrush="#795B2D" BorderThickness="0,0,1,1" />
                            <ContentPresenter x:Name="ActionContent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,1" />
                            <Border x:Name="HoverOverlay" Background="Transparent" Margin="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#A9823C" />
                                <Setter TargetName="ActionContent" Property="Margin" Value="5,2,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="#74623F" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#CEAD54" BorderBrush="#785C30" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="ExpandedBoolVis" />
        <DataTemplate x:Key="ExpandedCostCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                <TextBlock Text="{Binding DucatCost}" VerticalAlignment="Center" />
                <Image Source="{DynamicResource GoldCurrencyArt}" Width="11" Height="11" Margin="3,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding CostIsGold, Converter={StaticResource ExpandedBoolVis}}" />
                <Image Source="{DynamicResource DucatCurrencyArt}" Width="11" Height="11" Margin="3,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding CostIsDucat, Converter={StaticResource ExpandedBoolVis}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ExpandedDucatCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                <TextBlock Text="{Binding Profit}" VerticalAlignment="Center" />
                <Image Source="{DynamicResource DucatCurrencyArt}" Width="11" Height="11" Margin="3,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ExpandedDucatPerMinuteCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                <TextBlock Text="{Binding ProfitPerMinute}" VerticalAlignment="Center" />
                <Image Source="{DynamicResource DucatCurrencyArt}" Width="11" Height="11" Margin="3,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasMinutes, Converter={StaticResource ExpandedBoolVis}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ExpandedGoldCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                <TextBlock Text="{Binding TotalGold}" VerticalAlignment="Center" />
                <Image Source="{DynamicResource GoldCurrencyArt}" Width="11" Height="11" Margin="3,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ExpandedGoldPerMinuteCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                <TextBlock Text="{Binding GoldPerMinute}" VerticalAlignment="Center" />
                <Image Source="{DynamicResource GoldCurrencyArt}" Width="11" Height="11" Margin="3,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasMinutes, Converter={StaticResource ExpandedBoolVis}}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ExpandedGoodsTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="5,3" />
        </Style>
    </Window.Resources>
    <Grid>
        <Image x:Name="ExpandedFrameImage" Stretch="Fill" IsHitTestVisible="False" />
        <Grid Height="62" VerticalAlignment="Top" Margin="42,2,42,0">
            <TextBlock Text="EXPANDED AUTO ROUTES" Foreground="#E8DDC2" FontSize="15" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
        </Grid>
        <Button x:Name="ExpandedCloseButton" Width="15" Height="15" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close expanded routes">
            <Image x:Name="ExpandedCloseButtonImage" Width="15" Height="15" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Button>
        <Grid Margin="58,99,58,0" Height="62" VerticalAlignment="Top">
            <Grid.RowDefinitions><RowDefinition Height="13"/><RowDefinition Height="25"/><RowDefinition Height="21"/></Grid.RowDefinitions>
            <TextBlock x:Name="ExpandedStatusText" Foreground="#F0E4CC" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <UniformGrid Grid.Row="1" Columns="2" Margin="0,1,0,1">
                <Button x:Name="TotalProfitTabButton" Content="TOTAL PROFIT" Click="TotalProfitTab_Click" Background="#A9823C" Foreground="#271D10" BorderBrush="#785B32" BorderThickness="1" FontSize="10" FontWeight="Bold" />
                <Button x:Name="ProfitPerMinuteTabButton" Content="PROFIT / MIN" Click="ProfitPerMinuteTab_Click" Background="#625946" Foreground="#E5DCC9" BorderBrush="#785B32" BorderThickness="1" FontSize="10" FontWeight="Bold" />
            </UniformGrid>
            <Grid x:Name="ExpandedColumnHeaders" Grid.Row="2" Margin="0,1,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="160"/><ColumnDefinition Width="95"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="70"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="ROUTE" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="TRANSPORT" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="COST" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="DUCATS" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="DUCATS / MIN" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="TIME" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="TOTAL GOLD" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="7" Text="GOLD / MIN" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="8" Text="SEASON POINTS" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="9" Text="GOODS TO BUY" Foreground="#F0E4CC" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>
        </Grid>
        <Grid Margin="58,161,58,73">
            <DataGrid x:Name="TotalProfitRoutesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionChanged="RouteGrid_SelectionChanged" FontSize="10" Foreground="#342C20" Background="#F1E4CC"
                      RowBackground="#F4E8D0" AlternatingRowBackground="#EBDAB9" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#B8A57C" VerticalGridLinesBrush="#C8B68F" Visibility="Visible">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ROUTE" Binding="{Binding Destination}" Width="170" />
                    <DataGridTextColumn Header="TRANSPORT" Binding="{Binding Transport}" Width="160" />
                    <DataGridTemplateColumn Header="COST" CellTemplate="{StaticResource ExpandedCostCell}" Width="95" />
                    <DataGridTemplateColumn Header="DUCATS" CellTemplate="{StaticResource ExpandedDucatCell}" Width="90" />
                    <DataGridTemplateColumn Header="DUCATS / MIN" CellTemplate="{StaticResource ExpandedDucatPerMinuteCell}" Width="100" />
                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="70" />
                    <DataGridTemplateColumn Header="TOTAL GOLD" CellTemplate="{StaticResource ExpandedGoldCell}" Width="100" />
                    <DataGridTemplateColumn Header="GOLD / MIN" CellTemplate="{StaticResource ExpandedGoldPerMinuteCell}" Width="90" />
                    <DataGridTextColumn Header="SEASON POINTS" Binding="{Binding SeasonalRankingPoints}" Width="120" />
                    <DataGridTextColumn Header="GOODS TO BUY" Binding="{Binding GoodsToBuy}" Width="*" ElementStyle="{StaticResource ExpandedGoodsTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="ProfitPerMinuteRoutesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionChanged="RouteGrid_SelectionChanged" FontSize="10" Foreground="#342C20" Background="#F1E4CC"
                      RowBackground="#F4E8D0" AlternatingRowBackground="#EBDAB9" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#B8A57C" VerticalGridLinesBrush="#C8B68F" Visibility="Collapsed">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ROUTE" Binding="{Binding Destination}" Width="170" />
                    <DataGridTextColumn Header="TRANSPORT" Binding="{Binding Transport}" Width="160" />
                    <DataGridTemplateColumn Header="COST" CellTemplate="{StaticResource ExpandedCostCell}" Width="95" />
                    <DataGridTemplateColumn Header="DUCATS" CellTemplate="{StaticResource ExpandedDucatCell}" Width="90" />
                    <DataGridTemplateColumn Header="DUCATS / MIN" CellTemplate="{StaticResource ExpandedDucatPerMinuteCell}" Width="100" />
                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="70" />
                    <DataGridTemplateColumn Header="TOTAL GOLD" CellTemplate="{StaticResource ExpandedGoldCell}" Width="100" />
                    <DataGridTemplateColumn Header="GOLD / MIN" CellTemplate="{StaticResource ExpandedGoldPerMinuteCell}" Width="90" />
                    <DataGridTextColumn Header="SEASON POINTS" Binding="{Binding SeasonalRankingPoints}" Width="120" />
                    <DataGridTextColumn Header="GOODS TO BUY" Binding="{Binding GoodsToBuy}" Width="*" ElementStyle="{StaticResource ExpandedGoodsTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Button x:Name="ApplySelectedRouteButton" Style="{StaticResource ExpandedGoldActionButton}" Width="270" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,58,35" Click="ApplySelectedRouteButton_Click" FontSize="10" FontWeight="Bold" ToolTip="Add the selected route to Custom Selection in the main window">
            <TextBlock x:Name="ApplySelectedRouteButtonText" Text="ADD SELECTED ROUTE TO CUSTOM" Opacity="0.4" />
        </Button>
    </Grid>
</Window>