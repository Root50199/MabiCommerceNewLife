<Window x:Class="MabiCommerceNewLife.CargoDispositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolve Existing Cargo" Width="540" Height="420" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#D8C69F" ResizeMode="CanResize"
        KeyDown="Window_KeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Border Background="#493A26" BorderBrush="#A88A46" BorderThickness="1" Padding="8,5">
            <StackPanel>
                <TextBlock x:Name="CargoDescriptionText" Foreground="#F4ECD9" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="Review prices before selling. Unedited destination prices are estimates, not live quotes."
                           Foreground="#D8C69F" FontSize="8" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,6,0,4">
            <TextBlock Text="SELL AT:" Foreground="#493A26" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="DestinationPicker" DisplayMemberPath="Name" SelectedValuePath="PostId"
                      SelectionChanged="DestinationPicker_SelectionChanged" VerticalContentAlignment="Center" />
        </DockPanel>
        <DataGrid x:Name="CargoPricesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="9"
                  Foreground="#342C20" Background="#F1E4CC" RowBackground="#F4E8D0"
                  AlternatingRowBackground="#EBDAB9" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#B8A57C" VerticalGridLinesBrush="#C8B68F">
            <DataGrid.Columns>
                <DataGridTextColumn Header="GOOD" Binding="{Binding ProductName}" Width="2*" />
                <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, StringFormat={}{0:N0}}" Width="60" />
                <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="85" />
                <DataGridTextColumn Header="PRICE TYPE" Binding="{Binding PriceType}" Width="95" />
                <DataGridTextColumn Header="SALE" Binding="{Binding SaleValue, StringFormat={}{0:N0}}" Width="85" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,5,0,2">
            <TextBlock x:Name="DispositionStatusText" Foreground="#54482F" FontSize="8" VerticalAlignment="Center" />
            <TextBlock x:Name="SaleTotalText" Foreground="#342C20" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="CLEAR CARGO" Click="ClearCargo_Click"
                    Background="#625946" Foreground="#F4ECD9" BorderBrush="#785B32" BorderThickness="1"
                    FontSize="8" FontWeight="Bold" />
            <Button Grid.Column="3" Content="CANCEL" Click="Cancel_Click"
                    Background="#625946" Foreground="#F4ECD9" BorderBrush="#785B32" BorderThickness="1"
                    FontSize="8" />
            <Button x:Name="SellCargoButton" Grid.Column="5" Content="SELL AT TOWN" Click="SellCargo_Click"
                    Background="#D2AA58" Foreground="#201B12" BorderBrush="#795E2D" BorderThickness="1"
                    FontSize="8" FontWeight="Bold" />
        </Grid>
    </Grid>
</Window>
