<Window x:Class="MabiCommerceNewLife.HoverOverlayToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Controls" Width="330" Height="32"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="Toolbar_PreviewMouseLeftButtonDown">
    <Border x:Name="ToolbarBackground" Background="#F5211A11" BorderBrush="#A88A46" BorderThickness="1" CornerRadius="4" Padding="6,3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DragHandle" Foreground="#F4ECD9" FontSize="11" FontWeight="Bold"
                       Background="Transparent" VerticalAlignment="Stretch" Padding="0,4,0,0" Cursor="SizeAll"
                       MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" />
            <CheckBox x:Name="ClickThroughCheckBox" Grid.Column="1" Content="Click-through" Foreground="#E9D9B8" FontSize="10"
                      VerticalAlignment="Center" Margin="4,0" Visibility="Collapsed"
                      ToolTip="Pass clicks through text and background; checklist squares stay clickable."
                      Checked="ClickThrough_Changed" Unchecked="ClickThrough_Changed" />
            <TextBlock Grid.Column="2" Text="Transparency" Foreground="#E9D9B8" FontSize="10" VerticalAlignment="Center" Margin="4,0" />
            <Slider x:Name="BackgroundTransparencySlider" Grid.Column="3" Width="78" Minimum="0" Maximum="100"
                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="2,0,5,0"
                    AutomationProperties.Name="Overlay background transparency"
                    ToolTip="Background transparency: 0% solid, 100% clear. Overlay text stays visible."
                    ValueChanged="BackgroundTransparency_ValueChanged" />
            <Button x:Name="MinimizeButton" Grid.Column="4" Content="-" Width="20" Height="20" Padding="0" Background="#493A26"
                    Foreground="#F4ECD9" BorderBrush="#A88A46" Cursor="Hand" Click="MinimizeButton_Click"
                    Margin="0,0,4,0" ToolTip="Minimize overlay" AutomationProperties.Name="Minimize overlay" />
            <Button Grid.Column="5" Content="X" Width="20" Height="20" Padding="0" Background="#493A26"
                    Foreground="#F4ECD9" BorderBrush="#A88A46" Cursor="Hand" Click="CloseButton_Click"
                    ToolTip="Turn off this overlay" />
        </Grid>
    </Border>
</Window>
