<Window x:Class="MabiCommerceNewLife.CommunityPendingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pending shared scans" Width="454" Height="250"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Image x:Name="BackgroundArt" Stretch="Fill" IsHitTestVisible="False" />
        <Grid Margin="28,4,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>
            <TextBlock Text="PENDING SHARED SCANS" Foreground="#F4ECD9" FontSize="14" FontWeight="Bold"
                       TextAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="PendingText" Grid.Row="2" Foreground="#E9D9B8" FontSize="13" TextWrapping="Wrap" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Upload and close" Width="140" Height="30" Margin="0,0,8,0"
                        Style="{DynamicResource CommerceActionButton}" Click="Upload_Click" />
                <Button Content="Discard" Width="100" Height="30" Margin="0,0,8,0"
                        Style="{DynamicResource CommerceActionButton}" Click="Discard_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="30" IsDefault="True" IsCancel="True"
                        Style="{DynamicResource CommerceActionButton}" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
