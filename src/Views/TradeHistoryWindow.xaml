<Window x:Class="MabiCommerceNewLife.TradeHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trade History" Width="454" Height="474" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="PaperScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="#D0BC91" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#7F5C32" BorderBrush="#624522" BorderThickness="1" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TotalLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9D9B8" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TotalValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0D78A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Canvas x:Name="Root" Width="454" Height="474" ClipToBounds="True">
        <Image x:Name="BackgroundArt" Canvas.Left="0" Canvas.Top="0" Width="454" Height="474" Stretch="Fill" />
        <Grid x:Name="TitleBar" Canvas.Left="12" Canvas.Top="4" Width="436" Height="40">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" ToolTip="Drag to move">
                <TextBlock Text="TRADE HISTORY" Foreground="#F4ECD9" FontSize="14" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button Grid.Column="1" Width="16" Height="16" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" Background="Transparent" BorderThickness="0" Click="Close_Click" ToolTip="Close" Cursor="Hand">
                <Image x:Name="CloseIcon" Width="15" Height="15" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Button>
        </Grid>

        <Grid Canvas.Left="22" Canvas.Top="56" Width="410" Height="40">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel ToolTip="Raw Gold earned: profit plus Commerce Mastery, Letter of Guarantee and other Gold bonuses">
                <TextBlock Text="Raw Gold" Style="{StaticResource TotalLabel}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image x:Name="RawGoldIcon" Width="14" Height="14" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="RawGoldTotal" Style="{StaticResource TotalValue}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" ToolTip="Ducats earned as profit and bonuses (not the gross sale)">
                <TextBlock Text="Ducats" Style="{StaticResource TotalLabel}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image x:Name="DucatIcon" Width="14" Height="14" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="DucatsTotal" Style="{StaticResource TotalValue}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" ToolTip="Converted total: raw Gold + Ducats × Gold per Ducat at the time of each sale, minus barter material and letter costs">
                <TextBlock Text="Total Gold" Style="{StaticResource TotalLabel}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image x:Name="TotalGoldIcon" Width="14" Height="14" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="TotalGoldTotal" Style="{StaticResource TotalValue}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="PaperPanel" Canvas.Left="22" Canvas.Top="104" Width="410" Height="300">
            <Grid.RowDefinitions><RowDefinition Height="2"/><RowDefinition Height="*"/><RowDefinition Height="2"/></Grid.RowDefinitions>
            <Border x:Name="PaperTop" Grid.Row="0" />
            <Border x:Name="PaperFill" Grid.Row="1" />
            <Border x:Name="PaperBottom" Grid.Row="2" />
            <Grid Grid.Row="1" Margin="8,4,4,4">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/><ColumnDefinition Width="74"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Sale" Foreground="#5A4320" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Ducats" Foreground="#5A4320" FontSize="12" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Gold" Foreground="#5A4320" FontSize="12" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" ToolTip="Raw Gold" />
                    <TextBlock Grid.Column="3" Text="Total" Foreground="#5A4320" FontSize="12" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" ToolTip="Converted total Gold" />
                </Grid>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No sales yet. Loads sold with the Sell button appear here." Foreground="#5A4320" FontSize="12" TextWrapping="Wrap" Margin="0,8,10,0" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="HistoryItems" Margin="0,0,2,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="36" Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="20000">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/><ColumnDefinition Width="74"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="#2E2414" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding GoodsText}" Foreground="#5A4320" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DucatsText}" Foreground="#2E2414" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding RawGoldText}" Foreground="#2E2414" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding TotalGoldText}" Foreground="{Binding TotalBrush}" FontSize="12" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                                                        <Button Grid.Column="4" Width="14" Height="14" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#A33A22" FontSize="12" FontWeight="Bold" Content="✕" Cursor="Hand" Click="RemoveEntry_Click" ToolTip="Delete this sale from the history" />
                                                                    </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="CountText" Canvas.Left="26" Canvas.Top="414" Width="250" Foreground="#E9D9B8" FontSize="12" />
        <Button x:Name="ClearButton" Canvas.Left="312" Canvas.Top="412" Width="120" Height="22" Click="Clear_Click" Background="#493A26" Foreground="#F4ECD9" BorderBrush="#A88A46" BorderThickness="1" FontSize="8" FontWeight="Bold" Cursor="Hand" Content="CLEAR HISTORY" ToolTip="Delete every logged sale and reset the running totals" />
    </Canvas>
</Window>
