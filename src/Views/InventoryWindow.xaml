<Window x:Class="MabiCommerceNewLife.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory and Modifiers" Width="454" Height="698" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="PaperEntry" TargetType="TextBox">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2E2414" />
            <Setter Property="CaretBrush" Value="#2E2414" />
            <Setter Property="Background" Value="#F7EEDB" />
            <Setter Property="BorderBrush" Value="#9C7E4B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Entry_PreviewMouseLeftButtonDown" />
            <EventSetter Event="GotKeyboardFocus" Handler="Entry_GotKeyboardFocus" />
        </Style>
        <Style x:Key="PaperLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E2414" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PaperHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A4320" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PaperCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2E2414" />
            <Setter Property="Background" Value="#F7EEDB" />
            <Setter Property="BorderBrush" Value="#9C7E4B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,0,16,0" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#2E2414" />
                        <Setter Property="Background" Value="#F7EEDB" />
                        <Setter Property="Padding" Value="5,3" />
                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E6D3A8" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EADCBC" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False" />
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ClickSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClickSurface" Property="BorderBrush" Value="#6E5530" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Path Data="M 0 0 L 8 0 L 4 4 Z" Fill="#5A4320" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" IsHitTestVisible="False" />
                            <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#F7EEDB" BorderBrush="#9C7E4B" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Canvas x:Name="Root" Width="454" Height="698" ClipToBounds="True">
        <Image x:Name="BackgroundArt" Canvas.Left="0" Canvas.Top="0" Width="454" Height="698" Stretch="Fill" />
        <Grid Canvas.Left="12" Canvas.Top="4" Width="436" Height="40">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="INVENTORY &amp; MODIFIERS" Foreground="#F4ECD9" FontSize="14" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button Grid.Column="1" Width="16" Height="16" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" Background="Transparent" BorderThickness="0" Click="Close_Click" ToolTip="Close" Cursor="Hand">
                <Image x:Name="CloseIcon" Width="15" Height="15" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Button>
        </Grid>

        <Grid Canvas.Left="22" Canvas.Top="66" Width="410" Height="208">
            <Grid.RowDefinitions><RowDefinition Height="2"/><RowDefinition Height="*"/><RowDefinition Height="2"/></Grid.RowDefinitions>
            <Border x:Name="LettersPaperTop" Grid.Row="0" />
            <Border x:Name="LettersPaperFill" Grid.Row="1" />
            <Border x:Name="LettersPaperBottom" Grid.Row="2" />
            <Grid Grid.Row="1" Margin="8,2,8,2">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="48"/><ColumnDefinition Width="54"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Letter of Guarantee" Style="{StaticResource PaperHeader}" />
                    <TextBlock Grid.Column="1" Text="Trade" Style="{StaticResource PaperHeader}" TextAlignment="Right" Margin="0,0,4,0" ToolTip="Extra Ducats, Gold and EXP from the profit of trade and group goods" />
                    <TextBlock Grid.Column="2" Text="Barter" Style="{StaticResource PaperHeader}" TextAlignment="Right" Margin="0,0,4,0" ToolTip="Extra from the total selling price of barter goods" />
                    <TextBlock Grid.Column="3" Text="Have" Style="{StaticResource PaperHeader}" TextAlignment="Right" ToolTip="How many you own. Leave blank to not track; 0 means the letter cannot be applied." />
                    <TextBlock Grid.Column="4" Text="Market Gold" Style="{StaticResource PaperHeader}" TextAlignment="Right" ToolTip="What one letter sells for on the player market. Using a letter subtracts this value once per load. Blank or 0 turns the letter off, even if you own some." />
                </Grid>
                <ItemsControl x:Name="LetterItems" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="25" Background="Transparent" ToolTip="{Binding Tooltip}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="48"/><ColumnDefinition Width="54"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ShortName}" Style="{StaticResource PaperLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding NormalText}" Style="{StaticResource PaperLabel}" TextAlignment="Right" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="2" Text="{Binding BarterText}" Style="{StaticResource PaperLabel}" TextAlignment="Right" Margin="0,0,4,0" />
                                <TextBox Grid.Column="3" Style="{StaticResource PaperEntry}" Margin="6,0,0,0" MaxLength="5" Text="{Binding HaveText, Mode=OneTime}" Tag="{Binding}" TextChanged="LetterHave_TextChanged" LostKeyboardFocus="LetterHave_LostKeyboardFocus" ToolTip="Whole number from 0 to 9,999, or blank to not track" AutomationProperties.Name="{Binding HaveLabel}" />
                                <TextBox Grid.Column="4" Style="{StaticResource PaperEntry}" Margin="6,0,0,0" MaxLength="11" Text="{Binding ValueText, Mode=OneTime}" Tag="{Binding}" TextChanged="LetterValue_TextChanged" LostKeyboardFocus="LetterValue_LostKeyboardFocus" ToolTip="Whole Gold amount from 1 to 100,000,000. Blank or 0 turns the letter off, even if you own some." AutomationProperties.Name="{Binding ValueLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Grid Canvas.Left="22" Canvas.Top="282" Width="410" Height="84">
            <Grid.RowDefinitions><RowDefinition Height="2"/><RowDefinition Height="*"/><RowDefinition Height="2"/></Grid.RowDefinitions>
            <Border x:Name="EnchantPaperTop" Grid.Row="0" />
            <Border x:Name="EnchantPaperFill" Grid.Row="1" />
            <Border x:Name="EnchantPaperBottom" Grid.Row="2" />
            <Grid Grid.Row="1" Margin="8,2,8,2">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                <TextBlock Text="Accessory" Style="{StaticResource PaperHeader}" ToolTip="Commerce enchants on your two accessory slots. Purchase discounts widen the scan sanity check; Merchant Rating gain is tracked only." />
                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="Prefix" Style="{StaticResource PaperHeader}" Margin="4,0,0,0" />
                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="Suffix" Style="{StaticResource PaperHeader}" Margin="4,0,0,0" />
                <TextBlock Grid.Row="1" Text="Slot 1" Style="{StaticResource PaperLabel}" FontWeight="Bold" />
                <ComboBox x:Name="Slot1Prefix" Grid.Row="1" Grid.Column="1" Style="{StaticResource PaperCombo}" Margin="4,0,0,0" AutomationProperties.Name="Accessory slot 1 prefix enchant" />
                <TextBox x:Name="Slot1PrefixRoll" Grid.Row="1" Grid.Column="2" Style="{StaticResource PaperEntry}" Margin="4,0,0,0" MaxLength="1" Visibility="Collapsed" AutomationProperties.Name="Accessory slot 1 prefix rolled percent" />
                <ComboBox x:Name="Slot1Suffix" Grid.Row="1" Grid.Column="3" Style="{StaticResource PaperCombo}" Margin="8,0,0,0" AutomationProperties.Name="Accessory slot 1 suffix enchant" />
                <TextBox x:Name="Slot1SuffixRoll" Grid.Row="1" Grid.Column="4" Style="{StaticResource PaperEntry}" Margin="4,0,0,0" MaxLength="1" Visibility="Collapsed" AutomationProperties.Name="Accessory slot 1 suffix rolled percent" />
                <TextBlock Grid.Row="2" Text="Slot 2" Style="{StaticResource PaperLabel}" FontWeight="Bold" />
                <ComboBox x:Name="Slot2Prefix" Grid.Row="2" Grid.Column="1" Style="{StaticResource PaperCombo}" Margin="4,0,0,0" AutomationProperties.Name="Accessory slot 2 prefix enchant" />
                <TextBox x:Name="Slot2PrefixRoll" Grid.Row="2" Grid.Column="2" Style="{StaticResource PaperEntry}" Margin="4,0,0,0" MaxLength="1" Visibility="Collapsed" AutomationProperties.Name="Accessory slot 2 prefix rolled percent" />
                <ComboBox x:Name="Slot2Suffix" Grid.Row="2" Grid.Column="3" Style="{StaticResource PaperCombo}" Margin="8,0,0,0" AutomationProperties.Name="Accessory slot 2 suffix enchant" />
                <TextBox x:Name="Slot2SuffixRoll" Grid.Row="2" Grid.Column="4" Style="{StaticResource PaperEntry}" Margin="4,0,0,0" MaxLength="1" Visibility="Collapsed" AutomationProperties.Name="Accessory slot 2 suffix rolled percent" />
            </Grid>
        </Grid>

        <Grid Canvas.Left="22" Canvas.Top="374" Width="410" Height="36">
            <Grid.RowDefinitions><RowDefinition Height="2"/><RowDefinition Height="*"/><RowDefinition Height="2"/></Grid.RowDefinitions>
            <Border x:Name="MasteryPaperTop" Grid.Row="0" />
            <Border x:Name="MasteryPaperFill" Grid.Row="1" />
            <Border x:Name="MasteryPaperBottom" Grid.Row="2" />
            <Grid Grid.Row="1" Margin="8,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                <Image x:Name="MasteryIcon" Width="26" Height="26" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="MasteryLabel" Grid.Column="1" Text="Commerce Mastery" Style="{StaticResource PaperLabel}" FontWeight="Bold" />
                <ComboBox x:Name="MasteryRankPicker" Grid.Column="2" Style="{StaticResource PaperCombo}" SelectionChanged="MasteryRank_SelectionChanged" AutomationProperties.Name="Commerce Mastery rank" />
            </Grid>
        </Grid>

        <Grid Canvas.Left="22" Canvas.Top="416" Width="410" Height="320">
            <Grid.RowDefinitions><RowDefinition Height="2"/><RowDefinition Height="*"/><RowDefinition Height="2"/></Grid.RowDefinitions>
            <Border x:Name="ModifierPaperTop" Grid.Row="0" />
            <Border x:Name="ModifierPaperFill" Grid.Row="1" />
            <Border x:Name="ModifierPaperBottom" Grid.Row="2" />
            <ScrollViewer Grid.Row="1" Margin="8,2,4,2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <ToggleButton x:Name="RatingsToggle" Height="24" Cursor="Hand" Background="Transparent" BorderThickness="0" Checked="RatingsToggle_Changed" Unchecked="RatingsToggle_Changed" HorizontalContentAlignment="Stretch" ToolTip="Show or hide your Merchant Rating level for every outpost. Barter outposts have no Merchant Rating." AutomationProperties.Name="Merchant Ratings section">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z" Fill="#5A4320" VerticalAlignment="Center" Margin="1,0,6,0" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="Merchant Ratings" Style="{StaticResource PaperHeader}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ItemsControl x:Name="RatingItems" Visibility="Collapsed" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="24" Margin="0,0,8,0" Background="Transparent" ToolTip="{Binding Tooltip}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PaperLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBox Grid.Column="1" Style="{StaticResource PaperEntry}" MaxLength="3" Text="{Binding RatingText, Mode=OneWay}" Tag="{Binding}" TextChanged="Rating_TextChanged" LostKeyboardFocus="Rating_LostKeyboardFocus" ToolTip="Merchant Rating level: whole number, 1 or higher" AutomationProperties.Name="{Binding Label}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="ModifierItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="24" Background="Transparent" ToolTip="{Binding Tooltip}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.ColumnSpan="3" Text="{Binding Header}" Style="{StaticResource PaperHeader}" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="{Binding HeaderVisibility}" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PaperLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Visibility="{Binding RowVisibility}" />
                                <TextBlock Grid.Column="1" Text="{Binding Effect}" Style="{StaticResource PaperLabel}" Foreground="#5A4320" Margin="4,0" TextTrimming="CharacterEllipsis" Visibility="{Binding RowVisibility}" />
                                <CheckBox Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" IsChecked="{Binding IsChecked, Mode=OneWay}" Tag="{Binding}" Click="ModifierCheck_Click" Visibility="{Binding CheckVisibility}" AutomationProperties.Name="{Binding Name}" />
                                <TextBox Grid.Column="2" Style="{StaticResource PaperEntry}" MaxLength="3" Text="{Binding CountText, Mode=OneTime}" Tag="{Binding}" GotKeyboardFocus="ModifierCount_GotKeyboardFocus" TextChanged="ModifierCount_TextChanged" LostKeyboardFocus="ModifierCount_LostKeyboardFocus" Visibility="{Binding CountVisibility}" ToolTip="{Binding CountTooltip}" AutomationProperties.Name="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="FooterText" Canvas.Left="26" Canvas.Top="744" Width="402" Foreground="#E9D9B8" FontSize="11" TextWrapping="Wrap" />
    </Canvas>
</Window>