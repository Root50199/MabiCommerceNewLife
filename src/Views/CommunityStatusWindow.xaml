<Window x:Class="MabiCommerceNewLife.CommunityStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Price sharing status" Width="454" Height="390"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Image x:Name="BackgroundArt" Stretch="Fill" IsHitTestVisible="False" />
        <Grid Margin="28,4,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <Border Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="PRICE SHARING STATUS" Foreground="#F4ECD9" FontSize="14" FontWeight="Bold"
                           TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="IssueDetails" TextWrapping="Wrap" Foreground="#E9D9B8" FontSize="13" />
            </ScrollViewer>
            <TextBlock x:Name="WaitText" Grid.Row="3" TextWrapping="Wrap" Foreground="#E9D9B8"
                       FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="RetryButton" Content="Retry" Width="110" Height="30" Margin="0,0,12,0"
                        Style="{DynamicResource CommerceActionButton}" Click="Retry_Click" />
                <Button x:Name="CloseButton" Content="Close" Width="110" Height="30" IsDefault="True" IsCancel="True"
                        Style="{DynamicResource CommerceActionButton}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
