<Window x:Class="MabiCommerceNewLife.UserManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Manual - MabiCommerce NewLife" Width="820" Height="640" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#493A26" Foreground="#F4ECD9">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#74623F">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#CEAD54" BorderBrush="#785C30" BorderThickness="1" CornerRadius="2" MinHeight="18"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#66543A"/>
            <Setter Property="Foreground" Value="#F4ECD9"/>
            <Setter Property="BorderBrush" Value="#A88A46"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#80633F"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FFE5A2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="USER MANUAL" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
        <Border x:Name="WelcomePanel" Grid.Row="1" Background="#66543A" BorderBrush="#A88A46" BorderThickness="1" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Welcome! Would you like to go through the tutorial?" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="Learn the main controls step by step. You can exit anytime." TextWrapping="Wrap" Margin="0,6,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="WelcomeStartButton" Content="Start tutorial" Click="StartTour_Click" Margin="0,0,8,0"/>
                    <Button Content="Read manual" Click="ReadManual_Click" Margin="0,0,8,0"/>
                    <Button Content="Not now" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid x:Name="ManualPages" Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="ContentsList" Background="#F7EEDB" Foreground="#3B2E1B" BorderBrush="#A88A46" DisplayMemberPath="Title" SelectionChanged="Topic_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Manual contents">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#D6B65E"/></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#9C7E4B"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <Border Grid.Column="2" Background="#F7EEDB" BorderBrush="#A88A46" BorderThickness="1" Padding="18">
                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="TopicTitle" Foreground="#3B2E1B" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock x:Name="TopicInstructions" Foreground="#3B2E1B" FontSize="14" LineHeight="23" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Image x:Name="TopicScreenshot" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,0,0,8" AutomationProperties.Name="Illustration of the topic's app controls"/>
                        <TextBlock x:Name="ScreenshotNotice" Foreground="#755626" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="Example app view. Your values and available controls may differ."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Close" DockPanel.Dock="Right" Click="Close_Click" Margin="12,0,0,0"/>
            <Button x:Name="StartTourButton" Content="Start tutorial tour" DockPanel.Dock="Right" Click="StartTour_Click"/>
            <TextBlock Text="Local planning only. Check inputs and estimates against the game." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
