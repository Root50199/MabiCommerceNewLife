<Window x:Class="MabiCommerceNewLife.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App update available" Width="362" Height="218"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Image x:Name="BackgroundArt" Stretch="Fill" IsHitTestVisible="False" />
        <Grid Margin="22,4,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="62" />
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="UPDATE AVAILABLE" Foreground="#F4ECD9" FontSize="14" FontWeight="Bold"
                           TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="ReleaseSummary" Grid.Row="1" Foreground="#2E2414" FontSize="13"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="Download and install?" Foreground="#2E2414" FontSize="13"
                       TextAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="AcceptUpdateButton" Content="Yes" Width="96" Height="30" Margin="0,0,12,0"
                        Style="{DynamicResource CommerceActionButton}" Click="Yes_Click" />
                <Button x:Name="DeclineUpdateButton" Content="No" Width="96" Height="30" IsDefault="True" IsCancel="True"
                        Style="{DynamicResource CommerceActionButton}" Click="No_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
