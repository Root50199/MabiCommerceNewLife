<Window x:Class="MabiCommerceNewLife.ShoppingListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MabiCommerceNewLife"
        Title="Shopping List" Width="454" Height="442" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="PaperScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="#D0BC91" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#7F5C32" BorderBrush="#624522" BorderThickness="1" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HaveEntry" TargetType="TextBox">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2E2414" />
            <Setter Property="CaretBrush" Value="#2E2414" />
            <Setter Property="Background" Value="#F7EEDB" />
            <Setter Property="BorderBrush" Value="#9C7E4B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxLength" Value="9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Window.Resources>
    <Canvas x:Name="Root" Width="454" Height="442" ClipToBounds="True">
        <Image x:Name="BackgroundArt" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" />
        <Grid x:Name="TitleBar" Canvas.Left="12" Canvas.Top="4" Width="436" Height="40">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="SHOPPING LIST" Foreground="#F4ECD9" FontSize="14" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button Grid.Column="1" Width="16" Height="16" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" Background="Transparent" BorderThickness="0" Click="Close_Click" Cursor="Hand">
                <Image x:Name="CloseIcon" Width="15" Height="15" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Button>
        </Grid>

        <TextBlock x:Name="CartSummary" Canvas.Left="26" Canvas.Top="64" Width="402" Foreground="#F0D78A" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />

        <Grid x:Name="PaperPanel" Canvas.Left="22" Canvas.Top="104" Width="410" Height="300">
            <Grid.RowDefinitions><RowDefinition Height="2"/><RowDefinition Height="*"/><RowDefinition Height="2"/></Grid.RowDefinitions>
            <Border x:Name="PaperTop" Grid.Row="0" />
            <Border x:Name="PaperFill" Grid.Row="1" />
            <Border x:Name="PaperBottom" Grid.Row="2" />
            <Grid Grid.Row="1" Margin="8,4,4,4">
                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Material" Foreground="#5A4320" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="Needed" Foreground="#5A4320" FontSize="12" FontWeight="Bold" TextAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <local:InfoBubble HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-2,0" Message="Total materials for the goods in your cart." TipType="Information" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <TextBlock Text="Gold ea." Foreground="#5A4320" FontSize="11" FontWeight="Bold" TextAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <local:InfoBubble HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-2,0" Message="Saved market Gold per material. Shared with Barter Materials." TipType="Information" />
                    </Grid>
                    <Grid Grid.Column="3">
                        <TextBlock Text="Have" Foreground="#5A4320" FontSize="12" FontWeight="Bold" TextAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <local:InfoBubble HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-2,0" Message="Your saved on-hand count." TipType="Information" />
                    </Grid>
                    <TextBlock Grid.Column="4" Text="Still need" Foreground="#5A4320" FontSize="12" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="ShoppingItems" Margin="0,0,2,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="28" Background="Transparent" ToolTip="{Binding Tooltip}" local:TooltipCategoryService.Category="ItemStatus">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="#2E2414" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding NeededText}" Foreground="#2E2414" FontSize="13" TextAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Style="{StaticResource HaveEntry}" FontSize="11" MaxLength="14" Margin="4,0,4,0" IsEnabled="{Binding IsUnitCostEditable}" Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}" TextChanged="UnitCost_TextChanged" LostKeyboardFocus="UnitCost_LostKeyboardFocus" />
                                    <TextBox Grid.Column="3" Style="{StaticResource HaveEntry}" Margin="4,0,4,0" Text="{Binding HaveText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}" TextChanged="Have_TextChanged" LostKeyboardFocus="Have_LostKeyboardFocus" />
                                    <TextBlock Grid.Column="4" Text="{Binding StillNeedText}" Foreground="{Binding StillNeedBrush}" FontSize="13" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="TotalsText" Canvas.Left="26" Canvas.Top="400" Width="267" Height="20" Foreground="#E9D9B8" FontSize="12" />
        <Button x:Name="CopyForSheetsButton" Canvas.Left="302" Canvas.Top="400" Width="126" Height="20" Padding="3,0"
                Background="#E7D3AA" BorderBrush="#9C7E4B" BorderThickness="1" Foreground="#4A351A"
                Content="Copy for Sheets" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="CopyForSheets_Click"
                AutomationProperties.Name="Copy shopping list for Google Sheets" />
    </Canvas>
</Window>
