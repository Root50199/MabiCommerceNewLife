<Window x:Class="MabiCommerceNewLife.SharingConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanned price sharing" Width="454" Height="310"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Image x:Name="BackgroundArt" Stretch="Fill" IsHitTestVisible="False" />
        <Grid Margin="28,4,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="24" />
                <RowDefinition Height="126" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="SCANNED PRICE SHARING" Foreground="#F4ECD9" FontSize="14" FontWeight="Bold"
                           TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="ConsentSummary" Grid.Row="2" Foreground="#E9D9B8" FontSize="13" TextWrapping="Wrap"
                       Text="Send verified scans and receive community prices. Review edits are marked manual.&#10;&#10;No account data, screenshots or raw OCR. IP logs and new scan links expire after 30 days; price history stays.&#10;&#10;Your choice is saved. Turn sharing off anytime." />
            <Expander x:Name="PrivacyDetails" Grid.Row="3" Header="Privacy and details" Foreground="#E9D9B8" FontSize="12"
                      Expanded="PrivacyDetails_Changed" Collapsed="PrivacyDetails_Changed">
                <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PrivacyDetailsText" TextWrapping="Wrap" Margin="4" />
                </ScrollViewer>
            </Expander>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="AcceptSharingButton" Content="Enable" Width="110" Height="30" Margin="0,0,12,0"
                        Style="{DynamicResource CommerceActionButton}" Click="Enable_Click" />
                <Button x:Name="DeclineSharingButton" Content="Cancel" Width="110" Height="30" IsDefault="True" IsCancel="True"
                        Style="{DynamicResource CommerceActionButton}" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
