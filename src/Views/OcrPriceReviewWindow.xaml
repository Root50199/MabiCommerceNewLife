<Window x:Class="MabiCommerceNewLife.OcrPriceReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review OCR Prices" Width="980" Height="600" MinWidth="650" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="#D8C69F" ResizeMode="CanResize"
        KeyDown="Window_KeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <Border Background="#493A26" BorderBrush="#A88A46" BorderThickness="1" Padding="8,4">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="14"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                <TextBlock Text="REVIEW RECOGNIZED PRICES" Foreground="#F4ECD9" FontSize="10" FontWeight="Bold" />
                <TextBlock x:Name="OcrConfidenceText" Grid.Row="1" Foreground="#D8C69F" FontSize="8" />
                <DockPanel x:Name="SourcePricePanel" Grid.Row="2" LastChildFill="True">
                    <CheckBox x:Name="ApplySourcePriceCheck" Content="APPLY SOURCE PRICE" IsChecked="True" VerticalAlignment="Center" Foreground="#F4ECD9" FontSize="8" />
                    <TextBox x:Name="SourcePriceInput" Width="72" Margin="8,1" VerticalContentAlignment="Center" FontSize="9" />
                    <TextBlock x:Name="SourcePriceText" Foreground="#D8C69F" FontSize="8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Border>
        <DataGrid x:Name="OcrCandidatesGrid" Grid.Row="1" Margin="0,6,0,6" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" FontSize="9" Foreground="#342C20" Background="#F1E4CC" RowBackground="#F4E8D0" AlternatingRowBackground="#EBDAB9" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#B8A57C" VerticalGridLinesBrush="#C8B68F">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="APPLY" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                <DataGridTextColumn Header="TOWN" Binding="{Binding PostName}" IsReadOnly="True" Width="1.1*" />
                <DataGridTextColumn Header="PRICE" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="100" />
                <DataGridTextColumn Header="PRICE SOURCE" Binding="{Binding PriceSourceText}" IsReadOnly="True" Width="300" />
                <DataGridTextColumn Header="OCR TEXT" Binding="{Binding SourceLine}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="CONF." Binding="{Binding ConfidenceText}" IsReadOnly="True" Width="72" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ReviewStatusText" Text="Verify the town and price before applying." Foreground="#54482F" FontSize="8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="CANCEL" Click="Cancel_Click" Background="#625946" Foreground="#F4ECD9" BorderBrush="#785B32" BorderThickness="1" FontSize="8" />
            <Button Grid.Column="3" Content="APPLY SELECTED" Click="Apply_Click" Background="#D2AA58" Foreground="#201B12" BorderBrush="#795E2D" BorderThickness="1" FontSize="8" FontWeight="Bold" />
        </Grid>
    </Grid>
</Window>