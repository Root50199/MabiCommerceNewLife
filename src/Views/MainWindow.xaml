<Window x:Class="MabiCommerceNewLife.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MabiCommerceNewLife"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="MabiCommerce NewLife" Height="654" Width="995"
        MinHeight="654" MinWidth="995" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <sys:Double x:Key="BarterMaterialsIdleOpacity">0.4</sys:Double>
        <Style x:Key="CommerceActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#292016" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Image Source="{DynamicResource PurchaseButtonArt}" Stretch="Fill" IsHitTestVisible="False" />
                            <Border x:Name="ActionOverlay" Background="Transparent" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionOverlay" Property="Background" Value="#18FFFFFF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionOverlay" Property="Background" Value="#28000000" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <SolidColorBrush x:Key="Ink" Color="#F4ECD9" />
        <SolidColorBrush x:Key="Muted" Color="#786C54" />
        <SolidColorBrush x:Key="Line" Color="#756344" />
        <SolidColorBrush x:Key="Gold" Color="#C29B4A" />
        <Style x:Key="SettingsPlaceholderCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="CheckBoxFace" Background="#29251C" BorderBrush="#A88A46" BorderThickness="1" />
                            <Path x:Name="CheckMark" Data="M 2,7 L 5,10 L 12,2" Stroke="#F0D78A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBoxFace" Property="Background" Value="#554A35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Entry" TargetType="TextBox">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#29251C" />
            <Setter Property="BorderBrush" Value="#78633B" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="GameCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4ECD9" />
            <Setter Property="Background" Value="#493A26" />
            <Setter Property="BorderBrush" Value="#A88A46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F4ECD9" />
                        <Setter Property="Background" Value="#493A26" />
                        <Setter Property="Padding" Value="5,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#574A34" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#554A35" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False" />
                            <ToggleButton x:Name="PART_DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ClickSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClickSurface" Property="BorderBrush" Value="#8A7650" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ClickSurface" Property="BorderBrush" Value="#B79A61" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Path x:Name="ArrowPath" Data="M 0 0 L 8 0 L 4 4 Z" Fill="#F4ECD9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#493A26" BorderBrush="#A88A46" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#9A8150" />
                            </Trigger>
                            <Trigger Property="Background" Value="Transparent">
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="0" />
                                <Setter TargetName="PART_DropDownToggle" Property="Background" Value="Transparent" />
                                <Setter TargetName="PART_DropDownToggle" Property="BorderThickness" Value="0" />
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#16130F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransportGameCombo" TargetType="ComboBox" BasedOn="{StaticResource GameCombo}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False" />
                            <ToggleButton x:Name="PART_DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ClickSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ClickSurface" Property="BorderBrush" Value="#8A7650" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ClickSurface" Property="BorderBrush" Value="#B79A61" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Path x:Name="ArrowPath" Data="M 0 0 L 8 0 L 4 4 Z" Fill="#F4ECD9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#493A26" BorderBrush="#A88A46" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Background="#493A26" Margin="4,3,4,2" HorizontalAlignment="Center">
                                            <Border BorderBrush="#A88A46" BorderThickness="1" Padding="3,1" Margin="0,0,3,0">
                                                <CheckBox x:Name="PartnerFilterCheckBox" Content="Commerce Partner" Foreground="#F4ECD9" FontSize="7" Padding="0" Checked="PartnerEnabled_Changed" Unchecked="PartnerEnabled_Changed" ToolTip="Show Partner transports" />
                                            </Border>
                                            <Border BorderBrush="#A88A46" BorderThickness="1" Padding="3,1" Margin="0,0,3,0">
                                                <CheckBox x:Name="WilliamFilterCheckBox" Content="William" Foreground="#F4ECD9" FontSize="7" Padding="0" Checked="WilliamEnabled_Changed" Unchecked="WilliamEnabled_Changed" ToolTip="Show William's Partner transports" />
                                            </Border>
                                            <Border BorderBrush="#A88A46" BorderThickness="1" Padding="3,1">
                                                <CheckBox x:Name="AlpacaFilterCheckBox" Content="Alpaca" Foreground="#F4ECD9" FontSize="7" Padding="0" Checked="AlpacaEnabled_Changed" Unchecked="AlpacaEnabled_Changed" ToolTip="Show Alpaca Wagon when Wagon is available" />
                                            </Border>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="195">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.55" /></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#9A8150" /></Trigger>
                            <Trigger Property="Background" Value="Transparent">
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="0" />
                                <Setter TargetName="PART_DropDownToggle" Property="Background" Value="Transparent" />
                                <Setter TargetName="PART_DropDownToggle" Property="BorderThickness" Value="0" />
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#16130F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransportComboItem" TargetType="ComboBoxItem">
            <Setter Property="Visibility" Value="{Binding IsVisibleInList, Converter={StaticResource BooleanToVisibility}}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="#F4ECD9" />
            <Setter Property="Background" Value="#493A26" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="TransportItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsOwned, Mode=OneWay}" Visibility="{Binding IsOwnershipEditable, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="True" ToolTip="Available to this character" PreviewMouseLeftButtonDown="TransportOwnership_PreviewMouseLeftButtonDown" PreviewKeyDown="TransportOwnership_PreviewKeyDown" />
                                </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="TransportItemBorder" Property="Background" Value="#574A34" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TransportItemBorder" Property="Background" Value="#554A35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ParchmentGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#EADFC5" />
            <Setter Property="Foreground" Value="#342C20" />
            <Setter Property="BorderBrush" Value="#A28D61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#C7B78F" />
            <Setter Property="RowBackground" Value="#EFE4CC" />
            <Setter Property="AlternatingRowBackground" Value="#E6D8B8" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="ColumnHeaderHeight" Value="18" />
            <Setter Property="RowHeight" Value="16" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#D4C29A" />
                        <Setter Property="Foreground" Value="#342C20" />
                        <Setter Property="BorderBrush" Value="#A28D61" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="3,0" />
                        <Setter Property="FontSize" Value="8" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PickerNameTemplate">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
        </DataTemplate>
        <DataTemplate x:Key="PostPickerTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ProductTemplate">
            <Grid Width="273" Height="58" Background="Transparent" ToolTip="{Binding RecipeTooltip}" ToolTipService.IsEnabled="{Binding IsBarter}" ToolTipService.InitialShowDelay="1200" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="60000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.ColumnSpan="3" Source="{Binding RowBackground}" Stretch="Fill" IsHitTestVisible="False" />
                <Image Grid.ColumnSpan="3" Source="{Binding SelectedRowOverlay}" Stretch="Fill" IsHitTestVisible="False">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Border Width="48" Height="48" BorderBrush="#9D8244" BorderThickness="1" Background="#171614" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,6,0,0">
                    <Image Source="{Binding Icon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <Grid Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,0,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:OutlinedTextBlock Text="{Binding Name}" Foreground="#FFFFFF" OutlineBrush="#B4000000" FontSize="12" OutlineThickness="1">
                        <local:OutlinedTextBlock.Style>
                            <Style TargetType="local:OutlinedTextBlock">
                                <Style.Triggers><DataTrigger Binding="{Binding HasRotationAlternatives}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </local:OutlinedTextBlock.Style>
                    </local:OutlinedTextBlock>
                    <ComboBox Height="22" Margin="0,0,6,0" HorizontalAlignment="Stretch" ItemsSource="{Binding RotationAlternatives}" SelectedItem="{Binding Mode=OneWay}" Visibility="{Binding HasRotationAlternatives, Converter={StaticResource BooleanToVisibility}}" Background="#B2241C12" Padding="3,0,18,0" SelectionChanged="RotationPicker_SelectionChanged" PreviewMouseLeftButtonDown="RotationPicker_PreviewMouseLeftButtonDown" PreviewMouseWheel="RotationPicker_PreviewMouseWheel" ToolTip="{Binding RotationHistoryText}" ToolTipService.ShowDuration="60000">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource GameCombo}">
                                <Style.Triggers>
                                    <!-- Amber border until this week's offer has been picked or scanned. -->
                                    <DataTrigger Binding="{Binding IsRotationConfirmedThisWeek}" Value="False">
                                        <Setter Property="BorderBrush" Value="#E08A2E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <local:OutlinedTextBlock Text="{Binding Name}" Foreground="#FFFFFF" OutlineBrush="#B4000000" FontSize="12" OutlineThickness="1" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="2,0,38,7">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsWeeklyLimited}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <local:OutlinedTextBlock Text="Merchant Rating" Foreground="#FFFFFF" OutlineBrush="#AF000000" FontSize="7" OutlineThickness="0.85" TextAlignment="Right">
                        <local:OutlinedTextBlock.Style>
                            <Style TargetType="local:OutlinedTextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </local:OutlinedTextBlock.Style>
                    </local:OutlinedTextBlock>
                    <local:OutlinedTextBlock Text="{Binding LockText}" Foreground="#FFFFFF" OutlineBrush="#AF000000" FontSize="8" OutlineThickness="0.85" Margin="0,2,0,0" TextAlignment="Right">
                        <local:OutlinedTextBlock.Style>
                            <Style TargetType="local:OutlinedTextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </local:OutlinedTextBlock.Style>
                    </local:OutlinedTextBlock>
                    <local:OutlinedTextBlock Text="{Binding WeeklyLimitText}" Foreground="#FFFFFF" OutlineBrush="#AF000000" FontSize="7" OutlineThickness="0.85" TextAlignment="Right">
                        <local:OutlinedTextBlock.Style>
                            <Style TargetType="local:OutlinedTextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsWeeklyLimited}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </local:OutlinedTextBlock.Style>
                    </local:OutlinedTextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SlotTemplate">
            <Grid Width="77" Height="77">
                <Image Source="{DynamicResource InventorySlotFrame}" Width="67" Height="67" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TransportTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,7,0" />
                <local:OutlinedTextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#F4ECD9" FontSize="9" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="QuoteTemplate">
            <Grid Width="202" Height="14" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PostName}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PostName}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#533715" /><Style.Triggers><DataTrigger Binding="{Binding PostId}" Value="-1"><Setter Property="Foreground" Value="#5448ED" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBox Grid.Column="1" Text="{Binding DestinationPrice, UpdateSourceTrigger=PropertyChanged}" TextChanged="DestinationPrice_TextChanged" GotKeyboardFocus="DestinationPrice_GotKeyboardFocus" LostKeyboardFocus="DestinationPrice_LostKeyboardFocus" Background="Transparent" BorderBrush="#B8A57C" BorderThickness="0,0,0,1" Foreground="#342C20" FontSize="10" Padding="2,0" TextAlignment="Right" VerticalContentAlignment="Center" ToolTip="Enter an observed sale price; Smuggler has no automatic quote" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="2,0,0,0" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding PerItemProfitLossToolTip}">
                    <TextBlock Text="{Binding PerItemProfitLossText}" Foreground="{Binding PerItemProfitLossBrush}" FontSize="10" VerticalAlignment="Center" />
                    <Image Source="{DynamicResource GoldCurrencyArt}" Width="10" Height="10" Margin="2,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PerItemProfitIsGold}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Image.Style>
                    </Image>
                    <Image Source="{DynamicResource DucatCurrencyArt}" Width="10" Height="10" Margin="2,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding PerItemProfitIsDucat, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding EstimatedTimeText}" Foreground="#533715" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding EstimatedTimeToolTip}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DestinationTotalTemplate">
            <Grid Height="15" ToolTip="{Binding ProfitDetails}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="32"/><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PostName}" Foreground="#342C20" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding EstimatedTimeText}" Foreground="#6A5A41" FontSize="9" TextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ProfitPerMinuteText}" Foreground="#6A5A41" FontSize="9" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" />
                <Image Grid.Column="2" Source="{DynamicResource GoldCurrencyArt}" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" Visibility="{Binding ShowPerMinuteGoldIcon, Converter={StaticResource BooleanToVisibility}}" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                <Image Grid.Column="2" Source="{DynamicResource DucatCurrencyArt}" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" Visibility="{Binding ShowPerMinuteDucatIcon, Converter={StaticResource BooleanToVisibility}}" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="3" Text="{Binding DisplayValue}" Foreground="#342C20" FontSize="9" FontWeight="Bold" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Image Grid.Column="3" Source="{DynamicResource GoldCurrencyArt}" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" Visibility="{Binding ShowGoldIcon, Converter={StaticResource BooleanToVisibility}}" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AutoPlanTemplate">
            <Grid Width="202" Height="20" Margin="0" ToolTip="{Binding Tooltip}">
                <Grid.RowDefinitions><RowDefinition Height="10"/><RowDefinition Height="10"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="28"/><ColumnDefinition Width="48"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
