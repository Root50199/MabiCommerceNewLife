                                    <ListBox x:Name="DestinationTotalsList" Width="220" Height="15" HorizontalAlignment="Center" ItemTemplate="{StaticResource DestinationTotalTemplate}" SelectedValuePath="PostId" SelectionChanged="DestinationTotalsList_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Height" Value="15" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="DestinationRow" Background="Transparent" BorderBrush="#B9A77F" BorderThickness="0,0,0,1">
                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="DestinationRow" Property="Background" Value="#D6B65E" />
                                                                <Setter TargetName="DestinationRow" Property="BorderBrush" Value="#735321" />
                                                                <Setter TargetName="DestinationRow" Property="BorderThickness" Value="1" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

                    <Grid x:Name="PurchaseInputsPanel" Grid.Row="1" Grid.RowSpan="2" Width="148" HorizontalAlignment="Left" Margin="1,1,0,0">
                        <StackPanel x:Name="ManualPurchaseInputs">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="STOCK" Foreground="#F4ECD9" FontSize="9" FontWeight="Bold" />
                                    <TextBox x:Name="StockInput" Text="0" Style="{StaticResource Entry}" Height="19" FontSize="9" Padding="4,1" TextChanged="StockInput_TextChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="BuyPriceCaption" Text="BUY PRICE" Foreground="#F4ECD9" FontSize="9" FontWeight="Bold" />
                                    <Grid>
                                        <TextBox x:Name="BuyPriceInput" Text="" Style="{StaticResource Entry}" Height="19" FontSize="9" Padding="4,1" TextChanged="BuyPriceInput_TextChanged" ToolTip="Buy price at this town" />
                                        <Image x:Name="BuyPriceGoldIcon" Source="{DynamicResource DucatCurrencyArt}" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="PURCHASE QUANTITY" Foreground="#F4ECD9" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="0 = max" Foreground="#CDBB99" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0" />
                                </Grid>
                                <TextBox x:Name="QuantityInput" Text="0" Style="{StaticResource Entry}" Height="19" FontSize="9" Padding="4,1" />
                            </StackPanel>
                            <ComboBox x:Name="ManualLetterPicker" Height="18" Margin="0,3,0,0" Style="{StaticResource GameCombo}" FontSize="8" SelectionChanged="ActiveLetterPicker_SelectionChanged" />
                        </StackPanel>
                        <Grid x:Name="AutoPurchaseInputs" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="AutoSourcePicker" Grid.Column="0" Height="21" SelectedValuePath="Id" ItemTemplate="{StaticResource PickerNameTemplate}" SelectionChanged="AutoSourcePicker_SelectionChanged" Style="{StaticResource GameCombo}" FontSize="8" ToolTip="Choose the starting trading post" />
                                <TextBlock x:Name="AutoAllSourcesLabel" Grid.Column="0" Text="ALL SOURCES" Foreground="#F4ECD9" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Button x:Name="AutoCalculateButton" Grid.Column="1" Content="CALC" Margin="2,0,0,0" Click="AutoCalculate_Click" Background="#A9823C" Foreground="#271D10" BorderBrush="#785B32" BorderThickness="1" FontSize="8" FontWeight="Bold" ToolTip="Calculate the top routes from this start" />
                            </Grid>
                            <Button x:Name="ExpandedAutoRoutesButton" Grid.Row="1" Click="ExpandedAutoRoutesButton_Click" Background="#66543A" Foreground="#F4ECD9" BorderBrush="#A88A46" BorderThickness="1" ToolTip="Open all calculated routes with detailed metrics">
                                <TextBlock x:Name="ExpandedAutoRoutesButtonText" Text="VIEW ALL ROUTES" FontSize="7" FontWeight="Bold" Opacity="0.4" />
                            </Button>
                            <TextBlock x:Name="AutoStatusText" Grid.Row="2" Text="Choose a start town, then calculate." Foreground="#F4ECD9" FontSize="7" TextWrapping="Wrap" VerticalAlignment="Top" Margin="1,2,0,0" ToolTip="Purchase adds the plan to your cargo list" />
                        </Grid>
                        <StackPanel x:Name="LoadProfitInputs" Visibility="Collapsed">
                            <TextBlock Text="LETTER OF GUARANTEE" Foreground="#F4ECD9" FontSize="9" FontWeight="Bold" />
                            <ComboBox x:Name="LoadProfitLetterPicker" Height="19" Style="{StaticResource GameCombo}" FontSize="8" SelectionChanged="ActiveLetterPicker_SelectionChanged" />
                            <TextBlock x:Name="LoadProfitLetterWarning" Foreground="#F2C77A" FontSize="7" TextWrapping="Wrap" Margin="1,2,0,0" Visibility="Collapsed" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="RouteMapButton" Width="23" Height="21" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" IsEnabled="False" Click="RouteMapButton_Click" ToolTip="Open the route map overlay for the held goods' route" AutomationProperties.Name="Open route map overlay">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="2">
                                                <Path x:Name="RouteMapGlyph" Data="M1,4 L7,1 L13,4 L19,1 L19,16 L13,19 L7,16 L1,19 Z M7,1 L7,16 M13,4 L13,19" Stretch="Uniform" Fill="#3A2C19" Stroke="#D0A64D" StrokeThickness="1.6" StrokeLineJoin="Round" Opacity="0.8" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RouteMapGlyph" Property="Opacity" Value="1" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RouteMapGlyph" Property="Opacity" Value="1" /></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RouteMapGlyph" Property="Opacity" Value="0.3" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <ComboBox x:Name="RouteMapDestinationPicker" Grid.Column="1" Height="19" Margin="2,0,0,0" SelectedValuePath="Id" ItemTemplate="{StaticResource PickerNameTemplate}" Style="{StaticResource GameCombo}" FontSize="8" Visibility="Collapsed" SelectionChanged="RouteMapDestinationPicker_SelectionChanged" ToolTip="Destination for the route map. Lists towns that buy every held good." />
                                <TextBlock x:Name="RouteMapCaption" Grid.Column="1" Text="ROUTE MAP" Foreground="#F4ECD9" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="RouteMapRouteText" Foreground="#F4ECD9" FontSize="7" TextWrapping="Wrap" Margin="1,2,0,0" Text="Load goods to map their route." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Button x:Name="PurchaseActionButton" Canvas.Left="469" Canvas.Top="419" Width="74" Height="98" Style="{StaticResource CommerceActionButton}" Click="AddToLoad_Click" Content="Purchase" ToolTip="Add selected goods to the transport" />
            <Button x:Name="SellActionButton" Canvas.Left="469" Canvas.Top="419" Width="74" Height="98" Style="{StaticResource CommerceActionButton}" Click="SellLoad_Click" Content="Sell" Visibility="Collapsed" />
            <Border x:Name="StatusPanel" Canvas.Left="172.5" Canvas.Top="518" Width="480" Height="20" Padding="4,2" Background="#D8C69F" BorderBrush="#795E2D" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="StatusText" Foreground="#3A2C19" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>

            <Image x:Name="GoodsToCenterArrow" Canvas.Left="302" Canvas.Top="334" Width="20" Height="48" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
            <Image x:Name="TransportToCenterArrow" Canvas.Left="542" Canvas.Top="334" Width="20" Height="48" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />

            <Image x:Name="TransportHeaderImage" Canvas.Left="553" Canvas.Top="155" Width="240" Height="55" Stretch="Fill" IsHitTestVisible="False" />
            <ComboBox x:Name="TransportPicker" Canvas.Left="556" Canvas.Top="158" Width="234" Height="49" SelectedValuePath="Id" SelectionChanged="TransportPicker_SelectionChanged" DropDownOpened="TransportPicker_DropDownOpened" DropDownClosed="TransportPicker_DropDownClosed" ItemTemplate="{StaticResource TransportTemplate}" ItemContainerStyle="{StaticResource TransportComboItem}" Style="{StaticResource TransportGameCombo}" Background="Transparent" BorderThickness="0" Padding="4,2" FontSize="9" />

            <TextBlock Canvas.Left="556" Canvas.Top="215" Width="70" Height="12" Text="WEIGHT" Foreground="#54482F" FontSize="8" />
            <TextBlock x:Name="WeightText" Canvas.Left="716" Canvas.Top="215" Width="74" Height="12" Text="0 / 400" TextAlignment="Right" Foreground="#F4ECD9" FontSize="8" />
            <Image x:Name="WeightGaugeBackImage" Canvas.Left="556" Canvas.Top="230" Width="234" Height="8" Stretch="Fill" IsHitTestVisible="False" />
            <ProgressBar x:Name="WeightGauge" Canvas.Left="556" Canvas.Top="230" Width="234" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#C39A46" Background="Transparent" BorderThickness="0" />
            <TextBlock Canvas.Left="556" Canvas.Top="242" Width="60" Height="12" Text="Slots" Foreground="#54482F" FontSize="8" />
            <TextBlock x:Name="SlotText" Canvas.Left="716" Canvas.Top="242" Width="74" Height="12" Text="0 / 4" TextAlignment="Right" Foreground="#261F15" FontSize="8" />
            

            <Image x:Name="InventoryListGuardTopImage" Canvas.Left="560" Canvas.Top="262" Width="224" Height="15" Stretch="Fill" IsHitTestVisible="False" />
            <ScrollViewer Canvas.Left="561" Canvas.Top="265" Width="224" Height="211" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="8" />
                        <Setter Property="MinWidth" Value="8" />
                        <Setter Property="Background" Value="#D0BC91" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#7F5C32" BorderBrush="#624522" BorderThickness="1" CornerRadius="2" />
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>
                <Grid>
                    <ItemsControl x:Name="TransportSlots" Width="216" ItemTemplate="{StaticResource CargoSlotTemplate}" PreviewMouseRightButtonUp="TransportSlot_PreviewMouseRightButtonUp">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="72" ItemHeight="77" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Grid x:Name="TransportListView" Width="216" VerticalAlignment="Top" Margin="0,8,0,8" Visibility="Collapsed">
                        <ItemsControl x:Name="TransportListItems" ItemTemplate="{StaticResource CargoListTemplate}" PreviewMouseRightButtonUp="TransportListItem_PreviewMouseRightButtonUp" />
                        <TextBlock x:Name="TransportListEmptyText" Text="No goods held" Foreground="#54482F" FontSize="9" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Image x:Name="InventoryListGuardBottomImage" Canvas.Left="560" Canvas.Top="463" Width="224" Height="15" Stretch="Fill" IsHitTestVisible="False" />

            <Button x:Name="ShoppingListButton" Canvas.Left="553" Canvas.Top="477" Width="24" Height="17" Padding="0" Cursor="Hand" Visibility="Collapsed" Click="ShoppingListButton_Click" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Open barter shopping list" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ShoppingListChrome" BorderBrush="#826538" BorderThickness="1" CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#EBC468" Offset="0" />
                                    <GradientStop Color="#D0A64D" Offset="0.55" />
                                    <GradientStop Color="#B88E3C" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="{DynamicResource DetailsIconArt}" Width="16" Height="15" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ShoppingListChrome" Property="BorderBrush" Value="#FFF0B8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ShoppingListChrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Canvas.Left="545" Canvas.Top="502" Width="72" Text="Current Ducats" Foreground="#54482F" FontSize="8" TextAlignment="Right" />
            <Image x:Name="DucatPlateImage" Canvas.Left="620" Canvas.Top="494" Width="100" Height="27" Stretch="Fill" IsHitTestVisible="False" />
            <TextBox x:Name="DucatsInput" Canvas.Left="624" Canvas.Top="498" Width="91" Height="19" Text="10000" Style="{StaticResource Entry}" FontSize="9" Padding="4,1" TextChanged="DucatsInput_TextChanged" LostKeyboardFocus="DucatsInput_LostKeyboardFocus" />
            <Image Canvas.Left="699" Canvas.Top="502" Width="11" Height="11" Source="{DynamicResource DucatCurrencyArt}" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
            <Button x:Name="TransportViewToggleButton" Canvas.Left="768" Canvas.Top="477" Width="24" Height="17" Click="TransportViewToggle_Click" Cursor="Hand" ToolTip="Switch held goods to list view" AutomationProperties.Name="Toggle held goods view" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToggleChrome" BorderBrush="#826538" BorderThickness="1" CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#EBC468" Offset="0" />
                                    <GradientStop Color="#D0A64D" Offset="0.55" />
                                    <GradientStop Color="#B88E3C" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="{DynamicResource TransportViewToggleArt}" Width="18" Height="15" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#FFF0B8" />
                            </Trigger>
                            <Trigger Property="Tag" Value="List">
                                <Setter TargetName="ToggleChrome" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#B88E3C" Offset="0" />
                                            <GradientStop Color="#D0A64D" Offset="0.5" />
                                            <GradientStop Color="#E2B959" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Canvas.Left="730" Canvas.Top="495" Width="62" Height="25" Click="ClearLoad_Click" Background="#493A26" Foreground="#F4ECD9" BorderBrush="#A88A46" BorderThickness="1" FontSize="9" Cursor="Hand" Content="CLEAR LOAD" ToolTip="Clear the transport and restore source stock" />

            <Button x:Name="TradePageTab" Canvas.Left="46" Canvas.Top="111" Width="70" Height="19" Click="ShowTradePage_Click" Content="TRADE" Background="#C59E4B" Foreground="#201B12" BorderBrush="#795E2D" BorderThickness="1" FontSize="7" FontWeight="Bold" />
            <Button x:Name="GroupPageTab" Canvas.Left="120" Canvas.Top="111" Width="70" Height="19" Click="ShowGroupPage_Click" Content="GROUP" Background="#5B4524" Foreground="#F4ECD9" BorderBrush="#A88A46" BorderThickness="1" FontSize="7" FontWeight="Bold" />
            <Button x:Name="BarterPageTab" Canvas.Left="194" Canvas.Top="111" Width="70" Height="19" Click="ShowBarterPage_Click" Content="BARTER" Background="#5B4524" Foreground="#F4ECD9" BorderBrush="#A88A46" BorderThickness="1" FontSize="7" FontWeight="Bold" />
        </Canvas>
    </Viewbox>
</Window>
