<UserControl x:Class="MabiCommerceNewLife.InfoBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MabiCommerceNewLife"
             Width="12" Height="12" Focusable="False">
    <UserControl.Resources>
        <Style TargetType="ToggleButton">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Content" Value="i" />
            <Setter Property="Foreground" Value="#F4EAD6" />
            <Setter Property="Background" Value="#80675C4B" />
            <Setter Property="BorderBrush" Value="#BFD4C5AD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="BubbleFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BubbleFrame" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BubbleFrame" Property="Background" Value="#B36B604F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TipType, RelativeSource={RelativeSource AncestorType={x:Type local:InfoBubble}}}" Value="Tutorial">
                    <Setter Property="Content" Value="?" />
                    <Setter Property="Background" Value="#806C593F" />
                    <Setter Property="BorderBrush" Value="#BFDCC7AA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TipType, RelativeSource={RelativeSource AncestorType={x:Type local:InfoBubble}}}" Value="Information">
                    <Setter Property="Foreground" Value="#DDECE7" />
                    <Setter Property="Background" Value="#80536C6A" />
                    <Setter Property="BorderBrush" Value="#BFC4D6CC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TipFrame" TargetType="Border">
            <Setter Property="Background" Value="#E6F5EBDD" />
            <Setter Property="BorderBrush" Value="#C78C7B5D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TipType, RelativeSource={RelativeSource AncestorType={x:Type local:InfoBubble}}}" Value="Tutorial">
                    <Setter Property="BorderBrush" Value="#C7A98254" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#E6F5EBDD" BorderBrush="#C78C7B5D" BorderThickness="1"
                                CornerRadius="5" Padding="8,6">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#2E2414" FontSize="11"
                                       TextWrapping="Wrap" MaxWidth="560" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="TipToggle"
                      AutomationProperties.Name="{Binding AccessibleName, RelativeSource={RelativeSource AncestorType={x:Type local:InfoBubble}}}"
                      ToolTip="{Binding Message, RelativeSource={RelativeSource AncestorType={x:Type local:InfoBubble}}}"
                      ToolTipService.InitialShowDelay="1000" ToolTipService.ShowDuration="60000" />
        <Popup x:Name="TipPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=TipToggle}" IsOpen="{Binding IsChecked, ElementName=TipToggle, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="TipPopup_Opened">
            <Border x:Name="TipPopupBorder" Style="{StaticResource TipFrame}" MaxWidth="300">
                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType={x:Type local:InfoBubble}}}"
                           Foreground="#2E2414" FontSize="11" TextWrapping="Wrap" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
